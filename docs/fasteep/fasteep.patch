+        "ok": True,
+        "sleeping_ep_ranks": [2, 3],
+        "tags": ["expert_weights"],
+        "level": 1,
+    }
+    engine.collective_rpc.assert_awaited_once_with(
+        "sleep_ep_ranks_by_tags",
