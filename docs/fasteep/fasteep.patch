+    assert resp.status_code == 500
+    methods = [method for method, _ in rpc_calls]
+    assert methods == [
+        "get_ep_sleep_state",
+        "wake_up_ep_ranks",
+        "warm_sleep_backup",
+        "empty_cache",
+        "ensure_nixl_buffer",
+        "resize_sleep_ep_ranks",
